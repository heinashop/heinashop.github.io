# Replacement backend URL, ending in /api. Public URL only; never put secrets in VITE_* variables.
# Leave blank until the Cloudflare backend and Sheets permissions pass acceptance.
VITE_API_URL=

# Apps Script Web App URL, ending in /exec.
# Baked into the Pages bundle at build time (the URL is visible to browsers).
# Set this as a GitHub Actions variable named VITE_GAS_URL. Do not commit a real URL if you treat it as private.
VITE_GAS_URL=

# Asset prefix. GitHub project Pages: /heina-suite/
# Leave unset for local `npm run dev` (defaults to /).
VITE_BASE=
